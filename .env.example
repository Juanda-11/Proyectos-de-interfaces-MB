# Variables de entorno de la API (para desarrollo copia este archivo a .env.local).

# Base de datos: Upstash Redis. Si faltan, se usa memoria (solo desarrollo y pruebas).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IA para /api/analyze: basta con configurar un proveedor.
# Gemini (plan gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Fuerza el proveedor si hay dos claves: gemini | anthropic
# AI_PROVIDER=gemini

# Opcionales
# Secreto para firmar los tokens. Si falta se genera uno y se guarda en la base de datos.
# AUTH_SECRET=
# Orígenes permitidos por CORS, separados por coma (admite * como comodín). Por defecto: *
# ALLOWED_ORIGINS=https://foodlink-*.vercel.app
