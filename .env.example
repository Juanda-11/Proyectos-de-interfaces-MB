# Copia este archivo a .env.local para desarrollo. En Vercel se configuran en
# Settings > Environment Variables.

# --- Almacenamiento: Upstash Redis (OBLIGATORIO en Vercel) ---
# Si faltan, el servidor usa memoria (solo válido para desarrollo local: en Vercel
# cada instancia tendría datos distintos). La integración de Vercel inyecta
# KV_REST_API_URL / KV_REST_API_TOKEN, que también se aceptan.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- IA para /api/analyze: basta con configurar UNO ---
# Gemini (recomendado, plan gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Claude (de pago): https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Fuerza el proveedor si hay dos claves: gemini | anthropic
# AI_PROVIDER=gemini

# --- Seguridad (opcionales) ---
# Secreto para firmar los tokens. Si falta se genera uno y se guarda en Redis.
# AUTH_SECRET=
# Dominios del frontend permitidos por CORS, separados por coma. Por defecto: *
# ALLOWED_ORIGINS=https://tu-frontend.vercel.app
